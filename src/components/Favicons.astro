---
import favIcon from '~/assets/favicons/favicon.ico';
import favIconSvg from '~/assets/favicons/favicon.svg';
import appleTouchIcon from '~/assets/favicons/logo.png';
---
<link rel="shortcut icon" type="image/png" href={favIcon.src} />
<link rel="icon" type="image/png" href={favIcon.src} />
<link rel="apple-touch-icon" sizes="180x180" href={favIcon.src} />

